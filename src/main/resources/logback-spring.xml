<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      Structured JSON logs to stdout. Every event carries the request's correlationId
      (from MDC) so a domain event can be traced to its request. On the deploy host,
      stdout is captured into the public log stream.
    -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>false</includeContext>
            <customFields>{"service":"wallet-service"}</customFields>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <level>level</level>
                <logger>logger</logger>
                <thread>thread</thread>
                <message>message</message>
            </fieldNames>
        </encoder>
    </appender>

    <!-- Trim framework noise so domain events stand out in the stream. -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.springframework" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
